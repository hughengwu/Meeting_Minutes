# FunASR 全局热词（可选，也可在每次上传时单独填写）
# 示例：FUNASR_HOTWORDS=张三 李四 Kubernetes ROI
FUNASR_HOTWORDS=

# ── 字幕翻译 ─────────────────────────────────────────────────────────────────
# 以下只是默认值；前端「设置 → 字幕翻译」保存的配置（data/config.json）优先级更高

# google_free（默认，免 Key）/ google_v2（官方接口，需 Key）/ lmstudio（本地模型）
TRANSLATE_PROVIDER=google_free
TRANSLATE_TARGET_LANG=zh-CN

# 访问 Google 用的 HTTP 代理，留空则沿用系统 / HTTP_PROXY 环境变量
# 示例：TRANSLATE_PROXY=http://127.0.0.1:7890
TRANSLATE_PROXY=

# provider=google_v2 时必填（Google Cloud Translation v2 的 API Key）
GOOGLE_TRANSLATE_API_KEY=

# provider=lmstudio 时使用；模型留空表示用 LM Studio 中已加载的第一个模型
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=
